<apex:page standardStylesheets="false" controller="FormsCotroller" showHeader="false" sidebar="false"
    applyHtmlTag="false" applyBodyTag="false" docType="html-5.0">
    <html ng-app="ngApp">

    <head>
        <title>SalesForce | Portal Profile </title>
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <apex:stylesheet value="https://maxcdn.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css" />
        <apex:stylesheet value="{!URLFOR($Resource.portalAssets,'/assets/css/common.css')}" />
        <apex:stylesheet value="{!URLFOR($Resource.portalAssets,'/assets/css/header.css')}" />

        <link href="https://cdnjs.cloudflare.com/ajax/libs/angularjs-toaster/3.0.0/toaster.min.css" rel="stylesheet" />
        <link rel="icon" href="{!URLFOR($Resource.portalAssets,'/assets/image/expLogo.png')}" />
        <link rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />

        <apex:includeScript value="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js">
        </apex:includeScript>
        <apex:includeScript value="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></apex:includeScript>
        <apex:includeScript value="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css"></apex:includeScript>
        <apex:includeScript value="http://cdnjs.cloudflare.com/ajax/libs/underscore.js/1.4.4/underscore-min.js">
        </apex:includeScript>
        <apex:includeScript value="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js">
        </apex:includeScript>
        <apex:includeScript value="https://maxcdn.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js">
        </apex:includeScript>
        <apex:includeScript value="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.18.1/moment.min.js">
        </apex:includeScript>
        <apex:includeScript value="https://ajax.googleapis.com/ajax/libs/angularjs/1.6.9/angular.min.js">
        </apex:includeScript>
        <apex:includeScript value="https://cdnjs.cloudflare.com/ajax/libs/ng-idle/1.3.2/angular-idle.min.js"></apex:includeScript>
        <apex:includeScript value="https://ajax.googleapis.com/ajax/libs/angularjs/1.6.9/angular-sanitize.js">
        </apex:includeScript>
        <apex:includescript value="https://code.angularjs.org/1.7.9/angular-messages.js"></apex:includescript>
        <apex:includescript value="https://cdnjs.cloudflare.com/ajax/libs/angular-ui-bootstrap/1.3.3/ui-bootstrap-tpls.min.js">
        </apex:includescript>
        <apex:includescript value="https://cdnjs.cloudflare.com/ajax/libs/angularjs-toaster/3.0.0/toaster.min.js">
        </apex:includescript>

        <script type="text/javascript"
            src="http://maps.google.com/maps/api/js?key=AIzaSyCwkKCl-npTzxRSi0KZyDzUe1BuwqYEirA&sensor=true"></script>

        <script src="https://www.paynimo.com/paynimocheckout/client/lib/jquery.min.js" type="text/javascript"></script>
        <script type="text/javascript" src="https://www.paynimo.com/paynimocheckout/server/lib/checkout.js"></script>
        <!--  ----------------------------------------------------------------------  -->
        <!--  NOTE: Please add the following <META> element to your page <HEAD>.      -->
        <!--  If necessary, please modify the charset parameter to specify the        -->
        <!--  character set of your HTML page.                                        -->
        <!--  ----------------------------------------------------------------------  -->

        <apex:includeScript value="{!URLFOR($Resource.portalAssets,'/assets/js/FileUploadJS.js') }" />
        <script type="text/javascript">
            var __sfdcSessionId = '{!GETSESSIONID()}';
        </script>
        <script src="/soap/ajax/31.0/connection.js" type="text/javascript"></script>
        <META HTTP-EQUIV="Content-type" CONTENT="text/html; charset=UTF-8" />
    </head>

    <body ng-controller="profileCtrl">
        <div ng-show="showOverlay" class="overlay">
            <div class="loader">
                <img class="waitingImage" src="{!URLFOR($Resource.portalAssets,'/assets/image/loading.gif')}"
                    title="Please Wait..." />
            </div>
        </div>
        <nav class="navbar navbar-expand-lg navbar-light bg-white">
            <a class="navbar-brand ml-5" href="#">
                <img src="{!URLFOR($Resource.portalAssets,'/assets/image/Experian_logo.png')}" alt="Logo"
                    style="width:130px;" />
            </a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent"
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <toaster-container toaster-options="{'time-out': 4000}"></toaster-container>
        </nav>

        <div class="container-fluid">
            <div class="row">
                <div class="col block">
                    <div class="wrapper-progressBar" id="pregressBar">
                        <ul class="progressBar" style="width: 100%;" >
                            <li ng-class="(step.isActive || $index <= counter) ? 'active' : ''"
                                ng-repeat="step in steps">
                                <i class="{{step.icon}}" style="width: 16% !important;"
                                    ng-style="{color : step.isActive || $index <= counter ? '#fff' : ''}"></i>
                                <span> {{step.stpName}}</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div ng-show="!SaveFormResponse.status" class="container bg-img shadow-lg mt-3">
            <div class="row page-row"></div>
            <div ng-switch="selection">
                <div ng-switch-when="Step 1">
                    <div class="row instruction">
                        <div class="heading">
                            Become A Member
                        </div>
                        <p>Please fill the form and click on Next to proceed. You can also save the form for later </p>
                    </div>

                    <form name="becomMemberForm" class="mt-2" novalidate="becomMemberForm">
                        <h5 class="border-line">Company Details</h5>
                        <div class="row">
                            
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="member_Type">PAN Number &nbsp; <span style="color: red">*</span> <span style="color:{{verfiedResponse[0].color}};font-size:11px"> <i class="{{verfiedResponse[0].icon}}"></i> {{verfiedResponse[0].msg}} </span> </label>
                                    <div class="input-group">
                                        <input ng-attr-type="{{ typePassword ? 'text' : 'password' }}"
                                            class="form-control"
                                            id="pan_number_id"
                                            name="pan_number"
                                            ng-model="becomMember.Pan_no_c"
                                            minlength="10"
                                            maxlength="10"
                                            ng-pattern="/^[A-Z]{3}[^P][A-Z]\d{4}[A-Z]$/"
                                            onkeypress="return (event.charCode > 47 && event.charCode < 58 || event.charCode > 64 && event.charCode < 91)"
                                        /> <span class="input-group-btn" ng-click="togglePassword()"> <button class="btn btn-default" type="button" style="margin-top: -2.5px;"> <i ng-class="typePassword ? 'fa fa-eye-slash' : 'fa fa-eye' "></i> </button> </span>                                        </div>
                                    <div ng-if="(becomMemberForm.pan_number.$dirty || becomMemberForm.$submitted)"
                                        ng-messages="becomMemberForm.pan_number.$error" style="color:maroon" role="alert">
                                        <div class="text-danger" ng-message="required">Please enter PAN</div>
                                        <div class="text-danger" ng-message="minlength">PAN number should be 10 digits</div>
                                        <div class="text-danger" ng-message="maxlength">PAN number should be 10 digits</div>
                                        <div class="text-danger" ng-message="pattern">Please enter a valid PAN Number</div>
                                    </div>
                                </div>
                            </div>
                            
                            <!--<div class="col-md-3">
                                <div class="form-group">
                                    <label for="member_Type">PAN Number &nbsp;
                                        <span style="color: red">*</span>
                                        <span style="color:{{verfiedResponse[0].color}};font-size:11px">
                                            <i class="{{verfiedResponse[0].icon}}"></i> {{verfiedResponse[0].msg}}
                                        </span>
                                    </label>
                                    <div class="input-group">

                                        <input ng-attr-type="{{ typePassword ? 'text' : 'password' }}"
                                            class="form-control" id="pan_number_id" name="pan_number"
                                            ng-model="becomMember.Pan_no_c" minlength="10" maxlength="10"
                                            onkeypress="return (event.charCode > 47 && event.charCode < 58 || event.charCode > 64 && event.charCode < 91)" />
                                        <span class="input-group-btn" ng-click="togglePassword()">
                                            <button class="btn btn-default" type="button" style="margin-top: -2.5px;">
                                                <i ng-class="typePassword ? 'fa fa-eye-slash' : 'fa fa-eye' "></i>
                                            </button>
                                        </span>
                                    </div>
                                    <div ng-if="(becomMemberForm.pan_number.$dirty || becomMemberForm.$submitted)"
                                        ng-messages="becomMemberForm.pan_number.$error" style="color:maroon"
                                        role="alert">
                                        <div class="text-danger" ng-message="required">Please enter PAN</div>
                                        <div class="text-danger" ng-message="minlength">PAN number shoulde be 10 digit
                                        </div>
                                        <div class="text-danger" ng-message="maxlength">PAN number shoulde be 10 digit
                                        </div>
                                    </div>
                                </div>
                            </div>-->
                            
                            
                            <div class="col-md-3">
                                <div class="form-group">
                                    <button type="button" data-toggle="tooltip" title="click to verify you PAN number"
                                        style="margin-top: 1.3rem!important;width:165px" class="btn btn-primary"
                                        ng-click="getPANVerified(becomMember.Pan_no_c)">Verify PAN
                                        <i class="fa fa-check"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="company_Name">Company Name &nbsp;
                                        <span style="color: red">*</span>
                                    </label>
                                    <input type="text" id="company_Name_id" name="company_Name"
                                        ng-model="becomMember.Company" class="form-control" required="true"
                                        onkeypress="return (event.charCode > 64 && event.charCode < 91) || (event.charCode > 96 && event.charCode < 123) || (event.charCode == 32) || (event.charCode == 38) || (event.charCode == 40) || (event.charCode == 41) || (event.charCode == 45) || (event.charCode > 47 && event.charCode < 58)" />
                                    <div ng-if="(becomMemberForm.company_Name.$dirty || becomMemberForm.$submitted)"
                                        ng-messages="becomMember.company_Name.$error" style="color:maroon" role="alert">
                                        <div class="text-danger" ng-message="required">Please enter company name</div>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="member_Type">CIN &nbsp;
                                        <span style="color: red"
                                            ng-show="baknType == 'Public LTD' || baknType == 'Private LTD'">*</span>
                                            <span style="color:{{CINverfiedResponse[0].color}};font-size:11px">
                                                <i class="{{CINverfiedResponse[0].icon}}"></i> {{CINverfiedResponse[0].msg}}
                                            </span>
                                    </label>
                                    <input type="text" id="cin_id" name="cin"
                                        ng-model="becomMember.CIN_Company_Identification_Number_c" class="form-control"
                                        ng-required="baknType == 'Public LTD' || baknType == 'Private LTD'"
                                        onkeypress="return (event.charCode > 64 && event.charCode < 91) || (event.charCode > 96 && event.charCode < 123) || (event.charCode > 47 && event.charCode < 58) " disabled="true" />
                                    <div ng-if="(becomMemberForm.cin.$dirty || becomMemberForm.$submitted)"
                                        ng-messages="becomMemberForm.cin.$error" style="color:maroon" role="alert">
                                        <div class="text-danger" ng-message="required">Please enter CIN</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <button type="button" data-toggle="tooltip" title="click to verify you CIN details"
                                        style="margin-top: 1.3rem!important;width:165px" class="btn btn-primary"
                                        ng-click="getCINVerified(becomMember.Company,becomMember.CIN_Company_Identification_Number_c)" ng-disabled="cinbuttondisabled">Verify
                                        CIN
                                        <i class="fa fa-check"></i>
                                    </button>
                                </div>
                            </div>
                            <!-- <div class="col-md-6"> -->
                            <div ng-class="Class">
                                <div class="form-group">
                                    <label for="member_Type">Type of Institution &nbsp;
                                        <span style="color: red">*</span>
                                    </label>
                                    <br />
                                    <!-- <label class="radio-inline">
                                        <input type="radio" ng-model="baknType" ng-click="f_changeComType('Private LTD')" name="bakn_type" value="Private LTD" /> &nbsp;Private LTD
                                    </label>
                                    <label class="radio-inline ml-4">
                                        <input type="radio" ng-model="baknType" ng-click="f_changeComType('Public LTD')" name="bakn_type" value="Public LTD" />&nbsp;Public LTD
                                    </label>
                                    <label class="radio-inline ml-4">
                                        <input type="radio" ng-model="baknType" ng-click="f_changeComType('Other')" name="bakn_type" value="Other" />&nbsp;Other
                                    </label> -->
                                    <select class="form-control" required="true" id="bakn_type_id" name="bakn_type"
                                        ng-model="becomMember.Company_Type" ng-change="onChnagememberTypeList(becomMember.Company_Type)">
                                        <option ng-repeat="st in memberTypeList" value="{{st.name}}">{{st.name}}
                                        </option>
                                    </select>
                                    <div ng-if="(becomMemberForm.bakn_type.$dirty || becomMemberForm.$submitted)"
                                        ng-messages="becomMemberForm.bakn_type.$error" style="color:maroon"
                                        role="alert">
                                        <div class="text-danger" ng-message="required">Please enter type of institution</div>
                                    </div>
                                    <!-- <div>
                                        <input type="text" class="form-control" id="gst_number_id" name="gst_number"
                                        ng-model="becomMember.GST_No_c" disabled="true" />
                                    </div> -->
                                </div>
                            </div>
                            <div ng-if="(becomMember.Company_Type == 'Other')" ng-class="Class">
                                <div  class="form-group">
                                    <label for="member_Type">Type &nbsp;
                                        <span style="color: red">*</span>
                                    </label>
                                    <br />
                                    <div>
                                        <input type="text" class="form-control" id="other_type" name="other_type"
                                        ng-model="becomMember.Other_Type_c"  required="true"/>
                                    </div>
                                    <div ng-if="(becomMemberForm.Other_Type_c.$dirty || becomMemberForm.$submitted)"
                                        ng-messages="becomMemberForm.Other_Type_c.$error" style="color:maroon"
                                        role="alert">
                                        <div class="text-danger" ng-message="required">Please select Type </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="form-group">
                                    <!-- <label class="checkbox-container" style="margin-top:20px">GST Registered ?     
                                    </label>
                                    <input type="checkbox" class="form-control" required="true"
                                            ng-model="becomMember.GST_Registered_c"
                                            name="is_gst_registered" />
                                    <div ng-if="(becomMemberForm.is_gst_registered.$dirty || becomMemberForm.$submitted)"
                                        ng-messages="becomMemberForm.is_gst_registered.$error" style="color:maroon"
                                        role="alert">
                                        <div class="text-danger" ng-message="required">Please select GST registered or not </div>
                                    </div> -->

                                    <label for="member_Type">GST Registered ? &nbsp;
                                        <span style="color: red">*</span>
                                    </label>
                                    <br />
                                    <input type="radio"  ng-model="is_gst_registered" ng-click="gst_registered('Yes')"
                                        name="is_gst_registered" value="Yes" required="true"/>&nbsp;Yes &nbsp; &nbsp;
                                    
                                    <input type="radio"  ng-model="is_gst_registered"  ng-click="gst_registered('No')"
                                        name="is_gst_registered" value="No" required="true"/>&nbsp;No
                                    
                                    <div ng-if="(becomMemberForm.is_gst_registered.$dirty || becomMemberForm.$submitted)"
                                        ng-messages="becomMemberForm.is_gst_registered.$error" style="color:maroon"
                                        role="alert">
                                        <div class="text-danger" ng-message="required">Please select GST registered or not </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-9" ng-if="(becomMember.GST_Registered_c == undefined)">
                                <div class="form-group">
                                   
                                </div>
                            </div>
                            <div class="col-md-9" ng-if="(becomMember.GST_Registered_c =='No')">
                                <div class="form-group">
                                    <span style="color: red;font-size:11px;">'Dear Member, please note that you are agreeing to be onboarded as a Member to Experian and do not have an authorized GST Number. Your payment is being made inclusive of GST. Post receipt of the invoice without GST, changes will not be made on the Invoice.'</span>
                                </div>
                            </div>

                            <div class="col-md-3" ng-if="(becomMember.GST_Registered_c =='Yes')">
                                <div class="form-group">
                                    <label for="member_Type" >State of Registered Address &nbsp;
                                        <span style="color: red">*</span>
                                    </label>
                                    <select class="form-control" required="true" id="gst_state_id" name="gst_state"
                                        ng-model="becomMember.GST_State_c">
                                        <option ng-repeat="st in stateList" value="{{st.name}}">{{st.name}}</option>
                                    </select>
                                    <div ng-if="((becomMemberForm.gst_state.$dirty || becomMemberForm.$submitted)  && (becomMember.GST_Registered_c =='Yes'))"
                                        ng-messages="becomMemberForm.gst_state.$error" style="color:maroon"
                                        role="alert">
                                        <div class="text-danger" ng-message="required">Please enter state</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3" ng-if="(becomMember.GST_Registered_c =='Yes')">
                                <div class="form-group">
                                    <button type="button" data-toggle="tooltip" title="click to verify you pan details"
                                        style="margin-top: 1.3rem!important;;width:165px" class="btn btn-primary"
                                        ng-click="getVerified(becomMember.Company,becomMember.Pan_no_c,becomMember.GST_State_c)">Get
                                        GST
                                        <i class="fa fa-check"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-3" ng-If="(becomMember.GST_No_c && becomMember.GST_Registered_c !='No')">
                                <div class="form-group" >
                                    <label for="member_Type">GST &nbsp;
                                        <span style="color: red">*</span>
                                        <span style="color:{{verfiedResponse[1].color}};font-size:11px">
                                            <i class="{{verfiedResponse[1].icon}}"></i> {{verfiedResponse[1].msg}}
                                        </span>
                                    </label>
                                    <input type="text" class="form-control" id="gst_number_id" name="gst_number"
                                        ng-model="becomMember.GST_No_c" disabled="true" />
                                    <div ng-if="(becomMemberForm.gst_number.$dirty || becomMemberForm.$submitted)"
                                        ng-messages="becomMemberForm.gst_number.$error" style="color:maroon"
                                        role="alert">
                                        <div class="text-danger" ng-message="required">Please enter gst</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3" ng-if="(becomMember.GST_Registered_c == 'Yes' && (becomMember.GST_No_c =='' || becomMember.GST_No_c == undefined))">
                                <div class="form-group">
                                   
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="member_Type">Website &nbsp;
                                        <!-- <span style="color: red">*</span> -->
                                    </label>
                                    <input type="text" id="website_id" name="website" ng-model="becomMember.Website"
                                        class="form-control" onkeypress="return (event.charCode != 39)" />
                                    <div ng-if="(becomMemberForm.website.$dirty || becomMemberForm.$submitted)"
                                        ng-messages="becomMemberForm.website.$error" style="color:maroon" role="alert">
                                        <div class="text-danger" ng-message="required">Please enter website url</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="member_Type">Date of Incorporation &nbsp;
                                        <span style="color: red">*</span>
                                    </label>
                                    <!-- <input type="date" id="doi_id" name="doi" ng-disabled="becomMember.Date_of_Incorporation_c != undefined" ng-model="becomMember.Date_of_Incorporation_c" class="form-control" required="true" max='maxDate' /> -->
                                    <input type="date" id="doi_id" name="doi"
                                        ng-model="becomMember.Date_of_Incorporation_c" class="form-control"
                                        required="true" max='maxDate' />
                                    <div ng-if="(becomMemberForm.doi.$dirty || becomMemberForm.$submitted)"
                                        ng-messages="becomMemberForm.doi.$error" style="color:maroon" role="alert">
                                        <div class="text-danger" ng-message="required">Please enter date of
                                            incorporation</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="member_Type">Select Authorised Signatory (please click on "Verify CIN" to get signatory) &nbsp;
                                        <span style="color: red">*</span>
                                    </label>
                                    <br />
                                    <!-- becomMember.GST_State_c , authSignListValue-->
                                    <select class="form-control" required="true" id="auth_sign_list_id"
                                        name="auth_sign_list" ng-model="becomMember.authSignListValue"   
                                        ng-change="onChnageAuthSignList(becomMember.authSignListValue)">
                                        <option ng-repeat="st in authSignList" value="{{st.name}}">{{st.name}}</option>
                                    </select>
                                    <div ng-if="(becomMemberForm.auth_sign_list.$dirty || becomMemberForm.$submitted)"
                                        ng-messages="becomMemberForm.auth_sign_list.$error" style="color:maroon"
                                        role="alert">
                                        <div class="text-danger" ng-message="required">Please Select Authorised
                                            Signatory</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <div class="row">
                                        <div class="col-md-3">
                                            <button type="button" data-toggle="tooltip" title="click to verify with RBI"
                                                style="margin-top: 1.3rem!important;" class="btn btn-primary"
                                                ng-click="getRBIVerified(becomMember.Company,becomMember.Company_Type)">Verify with RBI
                                                <i class="fa fa-check"></i>
                                            </button>
                                        </div>
                                        <div class="col-md-9" style="margin-top: 25px">
                                            <span style="color:{{RBIverfiedResponse[0].color}};font-size:15px;">
                                                <i class="{{RBIverfiedResponse[0].icon}}"></i>
                                                {{RBIverfiedResponse[0].msg}}
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label data-toggle="tooltip" title="Select Image of your RBI Certificate"
                                        for="member_Type" style="font-size: 12px !important">Upload RBI / SEBI / IRDAI / TRAI Certificate &nbsp;
                                        <span style="color: red">*</span>
                                    </label>
                                    <input class="form-control" type="file" ng-model="rbiDocument" name="rbi_doc"
                                        valid-File="rbi_doc" id="rbi_doc_id"
                                        onchange="angular.element(this).scope().fileNameChanged('rbi_doc_id','file1')"
                                        accept="image/*,.pdf" ng-required="!rbiDisabled" ng-disabled="rbiDisabled" />
