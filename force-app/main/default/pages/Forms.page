                $scope.sendVerificationOtp = function () {
                    var leadId = window.localStorage.getItem("LeadId");
                    if (!leadId) {
                        $scope.showOverlay = false;
                        $scope.serverResponseForOTP = {
                            status: false,
                            msg: 'Unable to send OTP. LeadId is missing.',
                            color: 'red'
                        };
                        toaster.pop('error', $scope.serverResponseForOTP.msg);
                        return;
                    }

                    Visualforce.remoting.Manager.invokeAction(
                        '{!$RemoteAction.FormsCotroller.sendVerificationOTP}',
                        leadId,
                        function (result, event) {
                            $scope.safeApply(function () {
                                $scope.showOverlay = false;
                                if (result && result.status) {
                                    $scope.serverResponseForOTP = result;
                                    toaster.pop('success', result.msg);
                                    if ($scope.URLHaveId == true) {
                                        $scope.selection = $scope.steps[$scope.counter].stp;
                                    } else {
                                        $scope.incrementStep();
                                    }
                                } else {
                                    $scope.serverResponseForOTP = result || { status: false, msg: 'Failed to send OTP.', color: 'red' };
                                    toaster.pop('error', $scope.serverResponseForOTP.msg);
                                }
                            });
                        });
                };

