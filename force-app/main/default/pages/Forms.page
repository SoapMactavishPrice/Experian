                $scope.hasPreviousStep = function () {
                    var stepIndex = $scope.getCurrentStepIndex();
                    var previousStep = stepIndex - 1;
                    // Return true if there is a next step, false if not
                    return !_.isUndefined($scope.steps[previousStep]);
                };

                // --------------Function TO Navigate To Previous Step in Stepper-----------------//

                $scope.decrementStep = function () {
                    if ($scope.hasPreviousStep()) {
                        var stepIndex = $scope.getCurrentStepIndex();
                        $scope.steps[stepIndex].isActive = !$scope.steps[stepIndex].isActive;
                        var previousStep = stepIndex - 1;
                        $scope.selection = $scope.steps[previousStep].stp;
                        $scope.steps[previousStep].isActive = !$scope.steps[previousStep].isActive;
                        $scope.counter--;
                    }
                };

                // --------------Function TO Navigate To Next Step in Stepper-----------------//
				
                $scope.incrementStep = function () {
                    if ($scope.hasNextStep()) {
                        var stepIndex = $scope.getCurrentStepIndex();
                        $scope.steps[stepIndex].isActive = !$scope.steps[stepIndex].isActive;
                        var nextStep = stepIndex + 1;
                        $scope.steps[nextStep].isActive = !$scope.steps[nextStep].isActive;
                        $scope.selection = $scope.steps[nextStep].stp;
                        $scope.counter++;
                    }
                };
                    
                    
