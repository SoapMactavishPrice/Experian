        <script>
            var app = angular.module('ngApp', ['toaster', 'ngMessages', 'ui.bootstrap', 'ngSanitize','ngIdle']);
            app.directive('validFile', function () {
                return {
                    require: 'ngModel',
                    link: function (scope, el, attrs, ngModel) {
                        //change event is fired when file is selected
                        el.bind('change', function () {
                            scope.$apply(function () {
                                console.log(el);
                                ngModel.$setViewValue(el.val());
                                ngModel.$render();
                            });
                        });
                    }
                }
            });
            app.directive('tooltip', function () {
                return {
                    restrict: 'A',
                    link: function (scope, element, attrs) {
                        element.hover(function () {
                            // on mouseenter
                            element.tooltip('show');
                        }, function () {
                            // on mouseleave
                            element.tooltip('hide');
                        });
                    }
                };
            });
            app.directive('dScrollHorizontally', function () {
                return {
                    restrict: 'A',
                    link: function (scope, elem, attr) {
                        scope.scrollToRight = function () {
                            elem[0].scrollLeft += Number(attr.dScrollHorizontally);
                            console.log(elem);
                            console.log(elem[0].style);
                        }
                        scope.scrollToLeft = function () {
                            elem[0].scrollLeft -= Number(attr.dScrollHorizontally);
                            console.log(elem);
                        }

                    }
                }
            });

            app.controller('profileCtrl', function ($scope, toaster, $http, $sce,$timeout,Idle) {

                $scope.salesforceSiteLabel = '/'+'{!force_site_label}';
                var zip = '421306';
                var lat;
                var lng;
                var geocoder = new google.maps.Geocoder();
                geocoder.geocode({
                    'address': zip
                }, function (results, status) {
                    if (status == google.maps.GeocoderStatus.OK) {
                        geocoder.geocode({
                            'latLng': results[0].geometry.location
                        }, function (results, status) {
                            if (status == google.maps.GeocoderStatus.OK) {
                                if (results[1]) {
                                    var loc = getCityState(results);
                                    console.log('LOC-->', loc);
                                }
                            }
                        });
                    }
                });

                $scope.AlertPopupWindowData = '';
                $scope.User_Type_AdditionalDetails_popup_id
