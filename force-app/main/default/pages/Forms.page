                function handleResponse(res) {

                    if (typeof res != 'undefined' && typeof res.paymentMethod != 'undefined' && typeof res
                        .paymentMethod.paymentTransaction != 'undefined' && typeof res.paymentMethod
                        .paymentTransaction.statusCode != 'undefined' && res.paymentMethod.paymentTransaction
                        .statusCode == '0300') {
                        // success block
                        // console.log('handleResponse called sucess', res);
                        var pay_now_response = res.stringResponse
                        var response_split = pay_now_response.split('|');
                        var transaction_id = response_split[3];
                        var amount = response_split[6];
                        var date_time = response_split[8];
                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.FormsCotroller.update_payment_status_pay_now}',
                            transaction_id,
                            window.localStorage.getItem("LeadId"),
                            amount,
                            date_time,
                            function (result, event) {
                                // console.log(result);
                                if (result.status_value) {
                                    document.getElementById("btnSubmit_paynow").disabled = true;
                                    document.getElementById("btnSubmit_paylater").disabled = true;
                                    document.getElementById("paymentSubmit_next").disabled = false;
                                    document.getElementById("paymentSubmit_next").classList.remove(
                                        "btn-disabled");
                                    document.getElementById("btnSubmit_paylater").classList.add(
                                        "btn-disabled");
                                    document.getElementById("btnSubmit_paynow").classList.add(
                                        "btn-disabled");
                                    $scope.paymentSubmit();
                                    // var element = document.getElementById("myDIV");
                                    // element.classList.remove("mystyle");
                                } else {

                                }

                            })

                    } else if (typeof res != 'undefined' && typeof res.paymentMethod != 'undefined' &&
                        typeof res.paymentMethod.paymentTransaction != 'undefined' && typeof res.paymentMethod
                        .paymentTransaction.statusCode != 'undefined' && res.paymentMethod.paymentTransaction
                        .statusCode == '0398') {
                        // initiated block
                        // console.log('handleResponse called initiated');
                    } else {
                        // error block
                        //console.log('handleResponse called error');
                        document.getElementById("btnSubmit_paynow").disabled = false;
                        document.getElementById("btnSubmit_paylater").disabled = false;
                        document.getElementById("paymentSubmit_next").disabled = true;
                        document.getElementById("paymentSubmit_next").classList.add("btn-disabled");
                        document.getElementById("btnSubmit_paylater").classList.remove("btn-disabled");
                        document.getElementById("btnSubmit_paynow").classList.remove("btn-disabled");

                    }
                };

