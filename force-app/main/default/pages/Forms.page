                                        $scope.APILoginDetail.stage = 'Additional details';
                                        $scope.APILoginDetail.startTime = new Date();
                                    }
                                    if (result.planSelectionApex) {
                                        $scope.Payment_Detail = [];
                                        result.planSelectionApex.forEach((item, index) => {
                                            if (item.Product__r.Fee_Plan_Type__c == 'Fixed') {
                                                $scope.Payment_Detail.push(item);
                                            }
                                            if (item.Product__r.Fee_Plan_Type__c == 'Products') {
                                                $scope.variable_payment_data.forEach((subitem, index) => {
                                                    if (subitem.Name == item.Product__r.Name) {
                                                        $scope.variable_payment_data[index].Selected__c = true;
                                                    }
                                                });
                                            }
                                        });
                                        $scope.selection = $scope.steps[4].stp;
                                        $scope.counter = 4;
                                        $scope.APILoginDetail.stage = 'Plan selection';
                                        $scope.APILoginDetail.startTime = new Date();
                                    }
                                    if (result.paymentDetailApexForPlan) {
                                        $scope.Payment_Detail = [];
                                        result.paymentDetailApexForPlan.forEach((item, index) => {
                                            if (item.Product__r.Fee_Plan_Type__c == 'Fixed') {
                                                $scope.Payment_Detail.push(item);
                                            }
                                            if (item.Product__r.Fee_Plan_Type__c == 'Products') {
                                                $scope.variable_payment_data.forEach((subitem, index) => {
                                                    if (subitem.Name == item.Product__r.Name) {
                                                        $scope.variable_payment_data[index].Selected__c = true;
                                                    }
                                                });
                                            }
                                        });
                                        $scope.selection = $scope.steps[5].stp;
                                        $scope.counter = 5;
                                        $scope.APILoginDetail.stage = 'Payment';
                                        $scope.APILoginDetail.startTime = new Date();
                                    }
                                    if (result.paymentNextButton) {
                                        $scope.paymentNextButton = result.paymentNextButton;
                                    } else {
                                        $scope.paymentNextButton = result.paymentNextButton;
                                    }
                                    if (result.sentForAgreementReturnResult) {
                                        $scope.safeApply(function (params) {
                                            fetch('data:application/pdf;base64,' + result.sentForAgreementReturnResult.pdf)
                                                .then(response => response.blob())
                                                .then(blob => document.getElementById('agreement_Copy').src = URL.createObjectURL(blob));
                                            $scope.agreementcopyResponse = result.sentForAgreementReturnResult;
                                            $scope.selection = $scope.steps[6].stp;
                                            $scope.counter = 6;
                                            $scope.APILoginDetail.stage = 'Agreement Viewing';
                                            $scope.APILoginDetail.startTime = new Date();
                                        });
                                    }
                                    if (result.returnDocsStatus) {
                                        $scope.safeApply(function (params) {
                                            fetch('data:application/pdf;base64,' + result.returnDocsStatus.csvAsString)
                                                .then(response => response.blob())
                                                .then(blob => document.getElementById('agreement_signed_Copy').src = URL.createObjectURL(blob));
                                            $scope.selection = $scope.steps[7].stp;
                                            $scope.counter = 7;
                                            $scope.APILoginDetail.stage = 'Agreement signing';
                                            $scope.APILoginDetail.startTime = new Date();
                                        });
                                    }
                                });
                            } else {
                                $scope.safeApply(function (params) {
                                    console.log("ELSE");
                                    $scope.newWindowErrorMsg = result.msg;
                                });
                            }
                            $scope.safeApply(function (params) {
                                $scope.showOverlay = false;
                            });
                        });
                };

