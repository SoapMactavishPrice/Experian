                                        $scope.newWindowErrorMsg = result.msg;
                                    })
                                }
                            } else {
                                $scope.safeApply(function (param) {
                                    $scope.showOverlay = false;
                                })
                            }

                        });

                }

              

                $scope.attachBloblist = function (param) {
                    // console.log('attachBlob', param);
                    $scope.showOverlay = true;
                    $scope.uploadedFiles = [];

                    if (window.localStorage.getItem("uploadedFiles") != null) {
                        $scope.uploadedFiles = JSON.parse(window.localStorage.getItem("uploadedFiles"));
                    }

                    for (let index = 0; index < $scope.uploadedFiles.length; index++) {

                        //const element = $scope.uploadedFiles[index];

                        // console.log('$scope.uploadedFiles[index].fileTitle  === > ',$scope.uploadedFiles[index].fileTitle);
                        if ($scope.uploadedFiles[index].fileTitle == 'RBICertificate') {
                            $scope.uploadedFiles[index].base64value = document.getElementById('base64RBI')
                                .value;
                        } else if ($scope.uploadedFiles[index].fileTitle == 'PanCard') {
                            $scope.uploadedFiles[index].base64value = document.getElementById('base64PAN')
                                .value;
                        } else if ($scope.uploadedFiles[index].fileTitle == 'CompanyCertificate') {
                            $scope.uploadedFiles[index].base64value = document.getElementById('base64COM')
                                .value;
                        } else if ($scope.uploadedFiles[index].fileTitle == 'GSTCertificate') {
                            $scope.uploadedFiles[index].base64value = document.getElementById('base64GST')
                                .value;
                        } else if ($scope.uploadedFiles[index].fileTitle == 'AuthorisedSignatoryPanCard') {
                            $scope.uploadedFiles[index].base64value = document.getElementById('base64AuthPan')
                                .value;
                        }else if ($scope.uploadedFiles[index].fileTitle == 'Authorizationletter') {
                            $scope.uploadedFiles[index].base64value = document.getElementById('base64AuthLetter')
                                .value;
                        }
                    }

                    // console.log(' $scope.uploadedFiles  ', $scope.uploadedFiles);

                    // $scope.attachBlob(
                    //     param,
                    //     window.localStorage.getItem('LeadId'),
                    //     $scope.uploadedFiles[0].tempName,
                    //     $scope.uploadedFiles[0].fileTitle,
                    //     $scope.uploadedFiles[0].base64value
                    // );
                    // console.log($scope.uploadedFiles);

                    for (let index = 0; index < $scope.uploadedFiles.length; index++) {
                        if($scope.uploadedFiles[index].fileTitle  =='RBICertificate'){
                            $scope.attachBlob(
                                param,
                                window.localStorage.getItem('LeadId'),
                                $scope.uploadedFiles[index].tempName,
                                $scope.uploadedFiles[index].fileTitle,
                                $scope.uploadedFiles[index].base64value
                            );
                        }
                    }
                }


                $scope.planSelectionSubmit = function () {
                    $scope.showOverlay = true;
                    Visualforce.remoting.Manager.invokeAction(
                        '{!$RemoteAction.FormsCotroller.planSelection}',
                        window.localStorage.getItem("LeadId"),
                        JSON.stringify($scope.variable_payment_data),
                        JSON.stringify($scope.APILoginDetail),
                        function (result, event) {
                            // console.log(result);
                            if (result) {
                                if (result.status == true) {
                                    $scope.safeApply(function () {
                                        $scope.APILoginDetail.stage = 'Payment';
                                        $scope.APILoginDetail.startTime = new Date();
                                        if (result.goNext) {
                                            $scope.incrementStep();
                                            $scope.showOverlay = false;
                                        } else {
                                            $scope.SaveFormResponse.status = true;
                                            $scope.SaveFormResponse.msg =
                                                'your information has been successfully saved';
                                            $scope.SaveFormResponse.sing = 'fa fa-thumbs-up';
                                            var make_store = result.msg;
                                            var res = make_store.split(',');
                                            // console.log(res);

                                            $scope.SaveFormResponse.instruction = res[0];
                                            $scope.SaveFormResponse.instruction1 = res[1];
                                            $scope.SaveFormResponse.instruction2 = res[2];
                                            $scope.SaveFormResponse.instruction3 = res[3];
                                            $scope.SaveFormResponse.instruction4 = res[4];
                                            $scope.showOverlay = false;
                                        }
                                    });
                                } else {
                                    $scope.safeApply(function () {
                                        toaster.pop('error', "Plan Selectoin Failed");
                                        $scope.showOverlay = false;
                                    });
                                }
                            } else {
                                $scope.safeApply(function () {
                                    toaster.pop('error', "Plan Selectoin Failed");
                                    $scope.showOverlay = false;
                                });
                            }
                        })
                }

                if ('{!companyName}' != 'null') {
                    $scope.existingCompanyName = '{!companyName}';
                    var param = {
                        $valid: true
                    };
                    $scope.URLHaveId = false;
                    $scope.getLeadInfo(param);
                } else if ('{!companyName}' == '') {
                    $scope.existingCompanyName = '{!companyName}';
                    var modal = document.getElementById("new_member_form_id");
                    modal.style.display = "block";
                    $scope.URLHaveId = false;
                    // handleResponse(res);
                } else {
                    var a = location.href;
                    if (window.location.search) {
                        var b = a.substring(a.indexOf("?") + 1);
                        // console.log('b -> ', b);
                        $scope.URLHaveId = true;
                        $scope.getLeadInfoWithId(b);
                    } else {
                        $scope.URLHaveId = false;
                        
                        if ('{!companyName}' == 'null'){
                            $scope.existingCompanyName = ' ';
                            }else{
                            $scope.existingCompanyName = '{!companyName}';
                            }
                        var modal = document.getElementById("new_member_form_id");
                        modal.style.display = "block";
                    }
                }

                $scope.getStateCityPincode = function (param) {
                    $scope.detailMember.Billing_City_c = undefined;
                    $scope.detailMember.Billing_State_c = undefined;
                    $scope.detailMember.Billing_Country_c = undefined;
                    if (param) {
                        $scope.showOverlay = true;
                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.FormsCotroller.getStateCityPincode}',
                            param,
                            function (result) {
                                if (result) {
                                    $scope.safeApply(function (params) {
                                        $scope.detailMember.Billing_State_c = result
                                            .Statename__c;
                                        $scope.detailMember.Billing_Country_c = 'India';
                                        if (result.Taluk__c != 'N/A' || result.Taluk__c !=
                                            null || result.Taluk__c != '') {
                                            $scope.detailMember.Billing_City_c = result
                                            .Taluk__c;
                                        } else {
                                            $scope.detailMember.Billing_City_c = result
                                                .Divisionname__c;

                                        }
                                        $scope.showOverlay = false;
                                    })
                                } else {
                                    $scope.safeApply(function (params) {
                                        $scope.showOverlay = false;
                                    });
                                }
                            })
                    }

                }


