                $scope.fileNameChanged = function (param, keyName) {
                    console.log(param);
                    var fileName = document.getElementById(param).value;
                    var idxDot = fileName.lastIndexOf(".") + 1;
                    var extFile = fileName.substr(idxDot, fileName.length).toLowerCase();
                    if (extFile == "pdf" || extFile == "jpg" || extFile == "jpeg" || extFile == "gif" ||
                        extFile == "png" || extFile == "doc" || extFile == "docx" || extFile == "xls" ||
                        extFile == "xlsx" || extFile == "ppt" || extFile == "txt") {
                        //const fi= document.getElementById('rbi_doc_id');
                        const fi = document.getElementById(param);
                        if (fi.files.length > 0) {
                            console.log('filesize1', fi.files.length);
                            for (let i = 0; i <= fi.files.length - 1; i++) {
                                const fsize = fi.files.item(i).size;
                                const file = Math.round((fsize / 1024));
                                // The size of the file. 
                                console.log('filesize', file);

                                // if (file >= 5120) {  // 5 mb
                                if (file >= 1024) { // 1 mb
                                    //document.getElementById('rbi_doc_id').value = "";
                                    document.getElementById(param).value = "";
                                    //alert( "File size should be less than 5 MB. Please re-upload your file");     
                                    alert(
                                        "File size should be less than 1 MB (1024 KB). Please re-upload your file");
                                } else {

                                    if (param == 'rbi_doc_id') {
                                        $scope.uploadFile(param);
                                    } else if (param == 'pan_doc_id') {
                                        $scope.uploadFilePAN(param);
                                    } else if (param == 'com_doc_id') {
                                        $scope.uploadFileCOM(param);
                                    } else if (param == 'gst_doc_id') {
                                        $scope.uploadFileGST(param);
                                    }else if (param == 'user_auth_pan_doc_id') {
                                        $scope.uploadFilePAN_Auth(param);
                                    }else if (param == 'user_auth_letter_doc_id') {
                                        $scope.uploadFileAuthLetter(param);
                                    }else if (param == 'user_company_doc_id') {
                                        $scope.uploadFileAsPerComoanyDocument(param);
                                    }else if (param == 'user_pan_doc_id') {
                                         $scope.uploadFileAsPerPanCard(param);
                                    }


                                }
                            }
                        }
                    } else {
                        //document.getElementById('rbi_doc_id').value = "";
                        document.getElementById(param).value = "";
                        alert("This files is not allowed!");
                    }
                }

