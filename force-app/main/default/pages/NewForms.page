                return {
                    require: 'ngModel',
                    link: function (scope, el, attrs, ngModel) {
                        //change event is fired when file is selected
                        el.bind('change', function () {
                            scope.$apply(function () {
                                console.log(el);
                                ngModel.$setViewValue(el.val());
                                ngModel.$render();
                            });
                        });
                    }
                }
            });
            app.directive('tooltip', function () {
                return {
                    restrict: 'A',
                    link: function (scope, element, attrs) {
                        element.hover(function () {
                            // on mouseenter
                            element.tooltip('show');
                        }, function () {
                            // on mouseleave
                            element.tooltip('hide');
                        });
                    }
                };
            });
            app.directive('dScrollHorizontally', function () {
                return {
                    restrict: 'A',
                    link: function (scope, elem, attr) {
                        scope.scrollToRight = function () {
                            elem[0].scrollLeft += Number(attr.dScrollHorizontally);
                            console.log(elem);
                            console.log(elem[0].style);
                        }
                        scope.scrollToLeft = function () {
                            elem[0].scrollLeft -= Number(attr.dScrollHorizontally);
                            console.log(elem);
                        }

                    }
                }
            });


            app.directive('multiselectDropdown', function () {
                return {
                    restrict: 'E',
                    scope: {
                        model: '=',
                        options: '='
                    },
                    template:
                        "<div class='btn-group' data-ng-class='{open: open}' style='width: 200px;'>" +
                        "<button type='button' class='btn btn-small' style='width: 151%;height: 30px;border: 1px solid black;border-radius: 1px;' data-ng-click='openDropdown()' data-ng-foucs='openDropdown()'>---Select---</button>" +
                        "<ul class='dropdown-menu' aria-labelledby='dropdownMenu' style='position: absolute;'>" +
                        "<li style='cursor:pointer;' data-ng-repeat='option in options'><a data-ng-click='toggleSelectItem(option)'><span data-ng-class='getClassName(option)' aria-hidden='true'></span> {{option.name}}</a></li>" +
                        "</ul></div>",
                    controller: function ($scope) {

                        //$scope.webBackgroundDirectorList = [];

                        $scope.openDropdown = function () {
                            $scope.open = !$scope.open;
                        };

                        $scope.selectAll = function () {
                            $scope.model = [];
                            angular.forEach($scope.options, function (item, index) {
                                $scope.model.push(item);
                            });
                        };

                        $scope.deselectAll = function () {
                            $scope.model = [];
                        };

                        $scope.toggleSelectItem = function (option) {
                            var intIndex = -1;
                            var tempData = {};
                            angular.forEach($scope.model, function (item, index) {
                                console.log('toggle option' + option.din + 'index :::: >> ' + index + '<<>>>>>>' + item.din);
                                if (item.din == option.din) {
                                    console.log('option din');
                                    intIndex = index;
                                }
                            });

                            if (intIndex >= 0) {
                                $scope.model.splice(intIndex, 1);
                                tempData.model = $scope.model;
                                $scope.$emit('eventEmitedName', tempData);
                            } else {
                                $scope.model.push(option);
                                tempData.model = $scope.model;
                                $scope.$emit('eventEmitedName', tempData);
                            }

                        };


                        $scope.getClassName = function (option) {
                            var varClassName = 'glyphicon glyphicon-remove errorRemove';
                            angular.forEach($scope.model, function (item, index) {
                                if (item.din == option.din) {
                                    //console.log('item match is', item);
                                    varClassName = 'glyphicon glyphicon-ok successAdd';
                                }
                            });
                            return (varClassName);
                        };

                        $scope.$on('getParentCheckedName', function (event, data) {
                            angular.forEach(data, function (item, index) {
                                console.log('inside 1 for din', item.din);
                                $scope.toggleSelectItem(item);
                            });
                        });

                    }
                }
            });

