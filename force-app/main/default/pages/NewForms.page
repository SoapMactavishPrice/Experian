                // --------------Function TO Get Current Index of Stepper-----------------//

                $scope.getCurrentStepIndex = function () {
                    // Get the index of the current step given selection
                    //   return _.indexOf($scope.steps, $scope.selection);
                    return $scope.steps.findIndex(obj => obj.stp == $scope.selection);

                };

                // --------------Function TO Go Specefied Step of Stepper-----------------//

                $scope.goToStep = function (index, param) {
                    console.log(param.step);

                    var temp;
                    $scope.safeApply(function () {
                        if (!_.isUndefined($scope.steps[index])) {
                            $scope.selection = $scope.steps[index].stp;
                        }
                        // _.each($scope.steps, function (someThing) {
                        //     if (someThing.isActive == true) {
