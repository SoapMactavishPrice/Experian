                $scope.attachBlob = function (param, parentId, tempName, fileTitle, base64value) {
                    // console.log('attachBlob', fileTitle);
                    $scope.showOverlay = true;
                    Visualforce.remoting.buffer =
                        false; // Whether to group requests executed close to each other in time into a single request. The default is true
                    Visualforce.remoting.timeout = 120000; // Set timeout at page level
                    Visualforce.remoting.Manager.invokeAction(
                        '{!$RemoteAction.newFormsCotroller.attachBlob}',
                        parentId,
                        tempName,
                        fileTitle,
                        base64value,
                        function (result, event) {
                            // console.log('attachBlob--->', result);
                            if (result) {
                                if (result.status) {
                                    // console.log('uploaded', fileTitle);
                                    // $scope.attachBlobPAN(
                                    //     param,
                                    //     window.localStorage.getItem('LeadId'),
                                    //     $scope.uploadedFiles[1].tempName,
                                    //     $scope.uploadedFiles[1].fileTitle,
                                    //     $scope.uploadedFiles[1].base64value
                                    // );

                                    for (let index = 0; index < $scope.uploadedFiles.length; index++) {
                                        if ($scope.uploadedFiles[index].fileTitle == 'PanCard') {
                                            $scope.attachBlobPAN(
                                                param,
                                                window.localStorage.getItem('LeadId'),
                                                $scope.uploadedFiles[index].tempName,
                                                $scope.uploadedFiles[index].fileTitle,
                                                $scope.uploadedFiles[index].base64value
                                            );
                                        }
                                    }

                                } else {
                                    $scope.safeApply(function (param) {
                                        // console.log(fileTitle + " : file attachBlob failed");
                                        $scope.newWindowErrorMsg = result.msg;
                                    })
                                }
                            } else {
                                $scope.safeApply(function (param) {
                                    $scope.showOverlay = false;
                                })
                            }
                        });

                }

