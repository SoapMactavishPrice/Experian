$scope.fileNameChanged = function(param, keyName) {
    // Use $timeout to delay the execution of code
    console.log(param,keyName);
    $timeout(function() {
        let tempDoc = document.getElementById('fileUploadSupport');
        if (tempDoc) {
            console.log('files-->', tempDoc.files.length);

            let fileNameToSave = keyName;
            let fileName = '';
            let fsize = 0;
            let extFile = '';
            let base64 = ''; // Initialize base64 variable for file content

            // Loop through the selected files and process the first file selected
            if (tempDoc.files.length > 0) {
                $scope.files = []; // Clear out any previously stored files

                Array.from(tempDoc.files).forEach(file => {
                    fileName = file.name; // Get file name
                    fsize = file.size;    // Get file size
                    extFile = fileName.indexOf('.') > -1 ? fileName.split('.').pop().toLowerCase() : ''; // Get file extension
                    base64 = file; // Store file object (used with FileReader)

                    // Log the file details for debugging
                    console.log('fileName:--> ', fileName);
                    console.log('fileSize:--> ', fsize);
                    console.log('fileExtension:--> ', extFile);
                });
            }
            console.log('base64:--> ', base64);

            // Loop through the supporting documents array to find the matching key
            angular.forEach($scope.supportingDocumnets, function(document) {
                if (document.fileName === keyName) {
                    console.log('inside key');
                    document.isUploded = false;
                    document.isNotUploaded = false;
                    document.fileUplodedFail = false;

                    console.log('extFile=--->', extFile);
                    if (["pdf", "jpg", "jpeg", "gif", "png", "doc", "docx", "xls", "xlsx", "ppt", "txt"].includes(extFile)) {
                        console.log('Valid file extension');

                        if (fsize >= (1024 * 1024)) { // 1MB in bytes
                            alert("File size should be less than 1 MB (1024 KB). Please re-upload your file.");
                            document.isUploded = false;
                            document.isNotUploaded = true;
                            document.fileUplodedFail = true;
                        } else {
                            var reader = new FileReader();
                            document.isUploded = true;
                            document.isNotUploaded = false;
                            document.fileUplodedFail = false;

                            reader.onload = function(event) {
                                var fileData = event.target.result.split(',')[1]; // Base64 encoded file content
                                console.log('fileData: ', fileData);

                                Visualforce.remoting.Manager.invokeAction(
                                    '{!$RemoteAction.newFormsCotroller.uploaddocs}',
                                    window.localStorage.getItem("LeadId"),
                                    fileNameToSave,
                                    fileData,
                                    extFile,
                                    function(result, event) {
                                        console.log('Upload result: ', result.success);

                                        if (result.success === 'success') {
                                            document.isUploded = true;
                                            document.isNotUploaded = false;
                                            document.fileUplodedFail = false;
                                            $scope.showOverlay = false;
                                            console.log('File upload successful');
                                        } else {
                                            document.isUploded = false;
                                            document.isNotUploaded = true;
                                            document.fileUplodedFail = true;
                                            console.error('Error uploading file:', event);
                                        }
                                    }
                                );
                            };

                            // Read the file as Base64
                            reader.readAsDataURL(base64);
                        }
                    } else {
                        alert("This file type is not allowed!");
                        document.isUploded = false;
                        document.isNotUploaded = true;
                        document.fileUplodedFail = true;
                    }
                }
            });
        } else {
            console.error("File upload input element not found.");
        }
    }, 5000); // Delay the execution by 0 milliseconds, letting the DOM stabilize first
};


                
