                $scope.planSelectionSubmit = function () {
                    $scope.showOverlay = true;
                    Visualforce.remoting.Manager.invokeAction(
                        '{!$RemoteAction.newFormsCotroller.planSelection}',
                        window.localStorage.getItem("LeadId"),
                        JSON.stringify($scope.variable_payment_data),
                        function (result, event) {
                            // console.log(result);
                            if (result) {
                                if (result.status == true) {
                                    $scope.safeApply(function () {
                                        if (result.goNext) {
                                            $scope.incrementStep();
                                            $scope.showOverlay = false;
                                        } else {
                                            $scope.SaveFormResponse.status = true;
                                            $scope.SaveFormResponse.msg =
                                                'your information has been successfully saved';
                                            $scope.SaveFormResponse.sing = 'fa fa-thumbs-up';
                                            var make_store = result.msg;
                                            var res = make_store.split(',');
                                            // console.log(res);

                                            $scope.SaveFormResponse.instruction = res[0];
                                            $scope.SaveFormResponse.instruction1 = res[1];
                                            $scope.SaveFormResponse.instruction2 = res[2];
                                            $scope.SaveFormResponse.instruction3 = res[3];
                                            $scope.SaveFormResponse.instruction4 = res[4];
                                            $scope.showOverlay = false;
                                        }
                                    });
                                } else {
                                    $scope.safeApply(function () {
                                        toaster.pop('error', "Plan Selectoin Failed");
                                        $scope.showOverlay = false;
                                    });
                                }
                            } else {
                                $scope.safeApply(function () {
                                    toaster.pop('error', "Plan Selectoin Failed");
                                    $scope.showOverlay = false;
                                });
                            }
                        })
                }

