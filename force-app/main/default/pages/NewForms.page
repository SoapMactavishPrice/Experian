                $scope.attachBloblist = function (param) {
                    // console.log('attachBlob', param);
                    $scope.showOverlay = true;
                    $scope.uploadedFiles = [];

                    if (window.localStorage.getItem("uploadedFiles") != null) {
                        $scope.uploadedFiles = JSON.parse(window.localStorage.getItem("uploadedFiles"));
                    }

                    for (let index = 0; index < $scope.uploadedFiles.length; index++) {

                        //const element = $scope.uploadedFiles[index];

                        // console.log('$scope.uploadedFiles[index].fileTitle  === > ',$scope.uploadedFiles[index].fileTitle);
                        if ($scope.uploadedFiles[index].fileTitle == 'RBICertificate') {
                            $scope.uploadedFiles[index].base64value = document.getElementById('base64RBI')
                                .value;
                        } else if ($scope.uploadedFiles[index].fileTitle == 'PanCard') {
                            $scope.uploadedFiles[index].base64value = document.getElementById('base64PAN')
                                .value;
                        } else if ($scope.uploadedFiles[index].fileTitle == 'CompanyCertificate') {
                            $scope.uploadedFiles[index].base64value = document.getElementById('base64COM')
                                .value;
                        } else if ($scope.uploadedFiles[index].fileTitle == 'GSTCertificate') {
                            $scope.uploadedFiles[index].base64value = document.getElementById('base64GST')
                                .value;
                        } else if ($scope.uploadedFiles[index].fileTitle == 'AuthorisedSignatoryPanCard') {
                            $scope.uploadedFiles[index].base64value = document.getElementById('base64AuthPan')
                                .value;
                        } else if ($scope.uploadedFiles[index].fileTitle == 'Authorizationletter') {
                            $scope.uploadedFiles[index].base64value = document.getElementById('base64AuthLetter')
                                .value;
                        }
                    }

                    // console.log(' $scope.uploadedFiles  ', $scope.uploadedFiles);

                    // $scope.attachBlob(
                    //     param,
                    //     window.localStorage.getItem('LeadId'),
                    //     $scope.uploadedFiles[0].tempName,
