                    //     $scope.uploadedFiles[0].base64value
                    // );
                    // console.log($scope.uploadedFiles);

                    for (let index = 0; index < $scope.uploadedFiles.length; index++) {
                        if ($scope.uploadedFiles[index].fileTitle == 'RBICertificate') {
                            $scope.attachBlob(
                                param,
                                window.localStorage.getItem('LeadId'),
                                $scope.uploadedFiles[index].tempName,
                                $scope.uploadedFiles[index].fileTitle,
                                $scope.uploadedFiles[index].base64value
                            );
                        }
                    }
                }

