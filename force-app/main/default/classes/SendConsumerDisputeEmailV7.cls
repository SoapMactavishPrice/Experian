global class SendConsumerDisputeEmailV7 implements Database.Batchable<sObject>,schedulable,Database.AllowsCallouts ,Database.Stateful{
    //add by rishikesh

    // Logging
    // Auto_Dispute_Batch_Logs__c batchLog;
    Integer totalProcessed = 0;

    // Cycle time
    Datetime cutoffTime;
    Datetime startTime;
    
    global void execute(SchedulableContext SC) {
        database.executebatch(new SendConsumerDisputeEmailV7(),Integer.ValueOf(Label.SendConsumerDisputeVSize)); 
    }
    
    global  List<Case> start(Database.BatchableContext bc){

        // Create log
        // batchLog = BatchLogger.createLog('SendConsumerDisputeEmailV7');

        // Cycle logic
        cutoffTime = BatchCycleUtil.getCycleCutoff();
        startTime  = BatchCycleUtil.getStartTime(cutoffTime);
        
        List<Case> cselist = new List<Case> ();
        
        
        string query= 'Select Id,caseNumber, Status, Sub_Type_Lookup__c,Sub_Type_1_Lookup__c,Step_6_Acknowledge_Forward_To_Bank__c,Step_6_B_Forward_To_Bank__c,Displayed_Bank_Name__c,Displayed_Account_number__c, '+
            ' Name_of_Consumer__c, Sub_Type_1_Name__c, Owner.Name, Origin,Dispute_Raised_Date__c,Send_Email_to_Consumer__c,Forward_to_bank__c,Temp_Forward_to_Bank__c '+
            ' from Case  '+
            ' where Sub_Type_1_Name__c !=\'Junk\' '+
            ' and Sub_Type_1_Name__c !=null AND  '+
            ' (Case_Type_Name__c = \'Complaint Dispute Consumer\' OR Case_Type_Name__c = \'Complaint Dispute Commercial\') '+ 
            ' and Origin=\'Portal\' and AccountId !=null '+ 
            ' and Name_of_Consumer__c !=null and (Sub_Type_1_Name__c != \'Matching - Account does not belong to me\' AND Sub_Type_1_Name__c != \'Matching - Credit Enquiry does not belong to me\') '+
            ' and Displayed_Bank_Name__c !=null  '+
            ' and Displayed_Account_number__c !=null and  '+
            ' Date_of_the_email_received__c !=null AND Send_Email_to_Consumer__c = true and Status = \'Open\' '+ 
            ' and Step_1_Duplicate__c = false and Step_2_Resolved_Status__c = false and Step_3_Re_Raise__c = false and Step_4_Consumer_Raised_Dispute__c = false '+
            ' and CreatedDate >= :startTime and CreatedDate < :cutoffTime '+
            ' and Step_5_Consumer_Raised_Dispute_Open__c =false  and Step_6_Acknowledge_Forward_To_Bank__c = true and Step_6_B_Forward_To_Bank__c = false';
        
        if(!test.isRunningTest()){
            query+=' and Owner.Name=\'Consumer Support Queue\'';
        }
        query+=' order by CaseNumber asc';
        
        cselist = database.query(query);
        system.debug('cselist-->'+cselist.size());
        return cselist;
    }
    
    global void  execute (Database.BatchableContext bc , List<Case> Scope){

        totalProcessed += scope.size();

        map<Id,Case> csMap2 = new map<Id,Case>();
		List<Case> csList = Scope;
       List<API_LOG__c> apiList = new List<API_LOG__c>();
        for(Case cs : Scope){
                if(cs.Dispute_Raised_Date__c == system.today() && cs.Send_Email_to_Consumer__c){
                    //if(cs.Dispute_Raised_Date__c == system.today() && cs.Step_6_Acknowledge_Forward_To_Bank__c){
                    
                    API_LOG__c ap =new API_LOG__c();
                                ap.Request_Source__c=' Inside Step 7 '+cs.CaseNumber ;
                                ap.Case__c = cs.Id;
                                //ap.Exception_Description__c = 'Test ';
                                
                    
                    cs.Forward_to_bank__c = true;
                    cs.Temp_Forward_to_Bank__c = true;
                    cs.Step_6_B_Forward_To_Bank__c = true;
                    cs.Step_6_B_Forward_To_Bank_Date__c = system.today();
                    system.debug('--> inside Secord-->'+cs.caseNumber);
                    csMap2.put(cs.Id,cs);
                    apiList.add(ap);
                }
            }
        
        List<API_LOG__c> apliLogList = new List<API_LOG__c>();
        if(csMap2.size() > 0){
            Database.SaveResult[] srList = Database.update(csMap2.values(),false);
            
            for(Integer i=0;i<srList.size();i++){
                    if(!srList.get(i).isSuccess()){
                        system.debug('erro messa-->'+srList.get(i).isSuccess());
                        for(Database.Error err : srList[i].getErrors()) {
                            if(csMap2.containskey(csList[i].Id)){
                                API_LOG__c ap =new API_LOG__c();
                                ap.Request_Source__c='Step 7 Fail '+csMap2.get(csList[i].Id).CaseNumber ;
                                ap.Case__c = csMap2.get(csList[i].Id).Id;
                                ap.Exception_Description__c = err.getMessage();
                                apliLogList.add(ap);
                            } 
                        } 
                    }
                }
        }
        
        if(apiList.size() > 0){
            //insert apiList;
        }
        
        if(apliLogList.size() > 0){
                insert apliLogList;
            }
    }
    global void finish(Database.BatchableContext bc){

        // try{
