@RestResource(urlMapping='/fetchDisputeDetails/*')
global class fetchDisputeDetails {
    @HttpPost 
    global static void doPost(){
        
        API_LOG__c ap=new API_LOG__c();
        ap.Request_Source__c='fetchDisputeDetails Correx';
        RestRequest request = RestContext.request;  
        RestResponse response = RestContext.response;  
        Map<String,Object> responseObj = new Map<String,Object>();
        String jSONRequestBody=request.requestBody.toString().replace('\n', '');
        ap.Request__c=jSONRequestBody;
        JSON2Apex japex=JSON2Apex.parse(jSONRequestBody); 
        try{
            //---------------------------request----------------------------
            List<Dispute_Details_Fetching_Requests> reqList = japex.Dispute_Details_Fetching_Requests;
            Set<String> correxUniqueIdentifier=new Set<String>();
            Set<String> correxUniqueIdentifierAccountNUmber=new Set<String>();
            Set<String> caseIds=new Set<String>();
            for(Dispute_Details_Fetching_Requests row:reqList){
                //correxUniqueIdentifier.add(row.SF_Case_Number+'-'+row.Account_Number+'-'+row.Mobile_Number+'-'+row.Bureau_Member_id);
               correxUniqueIdentifier.add(row.SF_Case_Number+'-'+row.Mobile_Number+'-'+row.Bureau_Member_id);
               correxUniqueIdentifierAccountNumber.add(row.Account_Number);
                caseIds.add(row.SF_Case_Number);
            }
            
            List<DPD_Detail__c> dpdList=new List<DPD_Detail__c>();
            dpdList=[SELECT Id,Name,Case__c,Case__r.DIS_Dtl_Id__c,Correct_EMI_Amount__c,
                         Correct_EMI_Repayment_Month__c,Correct_EMI_Repayment_Year__c,
                         Displayed_EMI_Amount__c,Displayed_EMI_Repayment_Month__c,Displayed_EMI_Repayment_Year__c 
                         FROM DPD_Detail__c WHERE Case__r.CaseNumber IN:caseIds ];
             Map<String,List<DPD_Detail__c>> map_dpds=new Map<String,List<DPD_Detail__c>>();
            
            for(DPD_Detail__c dpdrow:dpdList){
                if(map_dpds.keySet().contains(dpdrow.Case__c)){
                  List<DPD_Detail__c> addDpd= map_dpds.get(dpdrow.Case__c);
                    addDpd.add(dpdrow);
                    map_dpds.put(dpdrow.Case__c,addDpd);//1234_1
                }else{
                    List<DPD_Detail__c> addDpd=new List<DPD_Detail__c>();
                    addDpd.add(dpdrow);
                    map_dpds.put(dpdrow.Case__c,addDpd);//1234_1
                }
                
            }
            System.debug('map_dpds == >'+map_dpds);
            System.debug('correxUniqueIdentifier == >'+correxUniqueIdentifier);
            Map<String, Schema.SObjectField> fieldMap = CASE.sObjectType.getDescribe().fields.getMap();
            
            // Get all of the fields on the object
            Set<String> setFieldNames = fieldMap.keySet();
            list<String> lstFieldNames = new List<String>(setFieldNames);
            
            // Dynamic Query String.
            List<Case> getRecordList = Database.query('SELECT Sub_Type_Lookup__r.Name,Account.Bureau_Member_Id__c,Sub_Type_1_Lookup__r.Name, ' + String.join(lstFieldNames, ',') + ' FROM Case WHERE Correx_fetch_details_unique_identifier__c IN: correxUniqueIdentifier AND Displayed_Account_number__c IN:correxUniqueIdentifierAccountNumber');
            List<Map<String,Object>> DisputeStatusTrackingResponsesList=new List<Map<String,Object>>(); 
            System.debug('getRecordList == >'+getRecordList);
            for(Case row:getRecordList){
                 System.debug('row.CaseNumber == >'+row.CaseNumber);
                Map<String,Object> mp=new  Map<String,Object>();
                mp.put('SF_Case_Number',row.CaseNumber);
                mp.put('Account_Number',row.Account.Bureau_Member_Id__c);
                mp.put('Mobile_Number',row.Contact_Phone__c);
                mp.put('Bureau_Member_id',row.Account.Bureau_Member_Id__c);
                mp.put('ContactEmailId',row.ContactEmail);
                mp.put('ContactMobileNo',row.Contact_Phone__c);
                mp.put('SubscriberId',null);
                mp.put('Comments',row.Comments);
                mp.put('Sub_Type',row.Sub_Type_Lookup__r.Name);
                mp.put('Sub_Type1',row.Sub_Type_1_Lookup__r.Name);
                mp.put('Dis_Id',row.DIS_Id__c);
                mp.put('Dis_Dtl_Id',row.DIS_Dtl_Id__c);
                mp.put('Dis_Uti',row.Dis_Uti__c);
                mp.put('Dis_Ern',row.Dis_Ern__c);
                mp.put('Dis_Raised_By',row.Dis_Raised_By__c);
                mp.put('Dis_Date',row.Dis_Date__c);
                
                Map<String,Object> mpAccountDetails=new  Map<String,Object>();
                mpAccountDetails.put('Displayed_Account_Status',row.Displayed_Account_Status__c);
                mpAccountDetails.put('Correct_Account_Status',row.Correct_Account_Status__c);
                mpAccountDetails.put('Displayed_Loan_Balance',row.Displayed_Loan_Balance__c);
                mpAccountDetails.put('Correct_Loan_Balance',row.Correct_Loan_Balance__c);
                mpAccountDetails.put('Displayed_Account_Opening_Date',row.Displayed_Account_Opening_Date__c);
                mpAccountDetails.put('Correct_Account_Opening_Date',row.Correct_Account_Opening_Date__c);
                mpAccountDetails.put('Displayed_Account_Type',row.Displayed_Account_Type__c);
                mpAccountDetails.put('Displayed_Bank_Name',row.Displayed_Bank_Name__c);
                mpAccountDetails.put('Displayed_Account_number',row.Displayed_Account_number__c);
                mpAccountDetails.put('Displayed_Loan_Type',row.Displayed_Loan_Type__c);
                mpAccountDetails.put('Correct_Loan_Type',row.Correct_Loan_Type__c);
                mpAccountDetails.put('Displayed_loan_Ownership',row.Displayed_loan_Ownership__c);
                mpAccountDetails.put('Correct_Loan_Ownership',row.Correct_Loan_Ownership__c);
                mpAccountDetails.put('Displayed_Amount_Overdue',row.Displayed_EMI_Amount__c);
                mpAccountDetails.put('Correct_Amount_Overdue',row.Correct_EMI_Amount__c);
                mp.put('AccoutDetailsList',mpAccountDetails);
                Map<String,Object> mpPersonalDetails=new  Map<String,Object>();
                mpPersonalDetails.put('Displayed_Name',row.Displayed_Name__c);
                mpPersonalDetails.put('Correct_Name',row.Correct_Name__c);
                mpPersonalDetails.put('Displayed_Date_of_Birth',row.Displayed_Date_of_Birth__c);
                mpPersonalDetails.put('Correct_Date_of_Birth',row.Correct_Date_of_Birth__c);
                mpPersonalDetails.put('Displayed_Gender',row.Displayed_Gender__c);
                mpPersonalDetails.put('Correct_Gender',row.Correct_Gender__c);
                mpPersonalDetails.put('Displayed_Address_1',row.Displayed_Address__c !=null?row.Displayed_Address__c:row.Displayed_Address_1_v1__c);
                mpPersonalDetails.put('Correct_Address_1',row.Correct_Address__c);
                mpPersonalDetails.put('Displayed_Address_2',row.Displayed_Address_2__c !=null?row.Displayed_Address_2__c:row.Displayed_Address_2_v1__c);
                mpPersonalDetails.put('Correct_Address_2',row.Correct_Address_2__c);
                mpPersonalDetails.put('Displayed_Address_3',row.Displayed_Address_3__c !=null?row.Displayed_Address_3__c:row.Displayed_Address_3_v1__c);
                mpPersonalDetails.put('Correct_Address_3',row.Correct_Address_3__c);
                mpPersonalDetails.put('Displayed_Address_4',row.Displayed_Address_4__c !=null?row.Displayed_Address_4__c:row.Displayed_Address_4_v1__c);
                mpPersonalDetails.put('Correct_Address_4',row.Correct_Address_4__c);
                mpPersonalDetails.put('Displayed_Address_5',row.Displayed_Address_5__c !=null?row.Displayed_Address_5__c:row.Displayed_Address_5_v1__c);
                mpPersonalDetails.put('Correct_Address_5',row.Correct_Address_5__c);
                mpPersonalDetails.put('Displayed_email_id',row.Displayed_Email_Id__c);
                mpPersonalDetails.put('Correct_email_id',row.Correct_Email_Id__c);
                mpPersonalDetails.put('Displayed_mobile_no_1',row.Displayed_Mobile_No__c);
                mpPersonalDetails.put('Correct_mobile_no_1',row.Correct_Mobile_No__c);
                mpPersonalDetails.put('Displayed_mobile_no_2',row.Displayed_Mobile_No_2__c);
                mpPersonalDetails.put('Correct_mobile_no_2',row.Correct_mobile_no_2__c);
                mpPersonalDetails.put('Displayed_mobile_no_3',row.Displayed_mobile_no_3__c);
                mpPersonalDetails.put('Correct_mobile_no_3',row.Correct_mobile_no_3__c);
                mpPersonalDetails.put('Displayed_mobile_no_4',row.Displayed_mobile_no_4__c);
                mpPersonalDetails.put('Correct_mobile_no_4',row.Correct_mobile_no_4__c);
                mpPersonalDetails.put('Displayed_mobile_no_5',row.Displayed_mobile_no_5__c);
                mpPersonalDetails.put('Correct_mobile_no_5',row.Correct_mobile_no_5__c);
                mpPersonalDetails.put('Correct_PAN_No',row.Correct_PAN_No__c);
                mpPersonalDetails.put('Displayed_PAN_No',row.Displayed_PAN_No__c);
                 mp.put('PersonalDetailsList',mpPersonalDetails);
                Map<String,Object> mpEnquiryDetails=new  Map<String,Object>();
                mpEnquiryDetails.put('Displayed_Enquired_For',row.Displayed_Enquired_For__c);
                mpEnquiryDetails.put('Correct_Enquired_For',row.Correct_Enquired_For__c);
                mpEnquiryDetails.put('Displayed_Enquired_By',row.Displayed_Enquired_By__c);
                mpEnquiryDetails.put('Correct_Enquired_By',row.Correct_Enquired_By__c);
                mpEnquiryDetails.put('Displayed_Enquiry_Date',row.Displayed_Enquiry_Date__c);
                mpEnquiryDetails.put('Correct_Enquiry_Date',row.Correct_Enquiry_Date__c);
                mp.put('EnquiryList',mpEnquiryDetails);
                Map<String,Object> AccountDoesNotBelongToMe=new  Map<String,Object>();
                /*AccountDoesNotBelongToMe.put('AccountType',row.Account_Type_Not_Belong__c);
                AccountDoesNotBelongToMe.put('BankName',row.Bank_Name_Not_Belong__c);
                AccountDoesNotBelongToMe.put('AccountNumber',row.Account_Number_Not_Belong__c);*/
                mp.put('AccountDoesNotBelongToMe',AccountDoesNotBelongToMe);
                Map<String,Object> DontSeeMyAccountHere=new  Map<String,Object>();
                /*DontSeeMyAccountHere.put('AccountType',row.Account_Type_Dont_see__c);
                DontSeeMyAccountHere.put('BankName',row.Bank_Name_Dont_see__c);
                DontSeeMyAccountHere.put('AccountNumber',row.Account_Number_Dont_see__c);*/
                 mp.put('DontSeeMyAccountHere',DontSeeMyAccountHere);
                mp.put('Case_Status',row.Status);
                if(row.Consumer_Dispute_Status__c!=null){
                    mp.put('Dispute_Status',row.Consumer_Dispute_Status__c);
                }else{
                    mp.put('Dispute_Status','Open');
                }
                if(map_dpds.get(row.Id)!=null){
                     List<DPD_Detail__c> getDis= map_dpds.get(row.Id);
                     List<Map<String,Object>> mpdis=new List<Map<String,Object>>();
                    for(DPD_Detail__c disrow:getDis){
                        Map<String,Object> mprow=new Map<String,Object>();
                        mprow.put('Dis_Dtl_Id',row.DIS_Dtl_Id__c);
                        mprow.put('Dpd_id',disrow.Name);
                        mprow.put('Displayed_EMI_Amount',disrow.Displayed_EMI_Amount__c);
                        mprow.put('Correct_EMI_Amount',disrow.Correct_EMI_Amount__c);
                        mprow.put('Displayed_EMI_Repayment_Month',disrow.Displayed_EMI_Repayment_Month__c);
                        mprow.put('Correct_EMI_Repayment_Month',disrow.Correct_EMI_Repayment_Month__c);
                        mprow.put('Displayed_EMI_Repayment_Year',disrow.Displayed_EMI_Repayment_Year__c);
                        mprow.put('Correct_EMI_Repayment_Year',disrow.Correct_EMI_Repayment_Year__c);
                        mpdis.add(mprow);
                    }
                    mp.put('Dpd_list',mpdis);  
                }else{
                     mp.put('Dpd_list',new List<Map<String,Object>>());  
                }
                
                mp.put('Error',null);
                
                
                DisputeStatusTrackingResponsesList.add(mp);
            }
            
            responseObj.put('Response_Status', 'Success');
            responseObj.put('Status', '200');
            responseObj.put('Dispute_Details_Fetching_Responses',DisputeStatusTrackingResponsesList);
            response.responseBody = Blob.valueOf(JSON.serialize(responseObj));
            response.statusCode = 200;
            response.addHeader('Content-Type', 'application/json');
            ap.Response__c=String.valueOf(responseObj);
        }catch(Exception e){
            System.debug('e.getMessage() '+e.getMessage());
            responseObj.put('Response_Status', e.getMessage());
            responseObj.put('Status', '400');
            response.responseBody = Blob.valueOf(JSON.serialize(responseObj));
            response.statusCode = 400;
            response.addHeader('Content-Type', 'application/json');
            ap.Exception_Description__c=e.getMessage();
            ap.Response__c=String.valueOf(responseObj);
        }
        insert ap;
        
    }
    public class JSON2Apex {
        public List<Dispute_Details_Fetching_Requests> Dispute_Details_Fetching_Requests;
    }
    
    public class Dispute_Details_Fetching_Requests {
        public String SF_Case_Number;
        public String Account_Number;
        public String Mobile_Number;
        public String Bureau_Member_id;
        
    }
    public static JSON2Apex parse(String json) {
        return (JSON2Apex) System.JSON.deserialize(json, JSON2Apex.class);
    }
    
