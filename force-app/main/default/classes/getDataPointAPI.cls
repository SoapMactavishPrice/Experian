                    mp_Demog_Data_Point_Decision_Response.put('PAN',false);
                    mp.put('Demog_Data_Point_Decision_Response',mp_Demog_Data_Point_Decision_Response);
                    
                    mp_Account_Data_Point_Decision_Response.put('Account_status',false);
                    mp_Account_Data_Point_Decision_Response.put('Loan_Balance',false);
                    mp_Account_Data_Point_Decision_Response.put('Overdue_Amount',false);
                    mp_Account_Data_Point_Decision_Response.put('Account_Type',false);
                    mp_Account_Data_Point_Decision_Response.put('Loan_Ownership',false);
                    mp_Account_Data_Point_Decision_Response.put('Account_Opened_Date',false);
                    mp_Account_Data_Point_Decision_Response.put('EMI_Amount',false);
                    mp_Account_Data_Point_Decision_Response.put('EMI_Repayment_History',false);
                    mp_Account_Data_Point_Decision_Response.put('Account_Does_Not_Belongs_To_Me',false);
                    mp_Account_Data_Point_Decision_Response.put('Credit_Facility_Status',false);
                    mp.put('Account_Data_Point_Decision_Response',mp_Account_Data_Point_Decision_Response);
                    
                }
                mp.put('Account_Number',reqrow.Account_Number);
                mp.put('Error',null);
                DisputeStatusTrackingResponsesList.add(mp);
                
            }
            
            // Query for relevant cases based on criteria
            String enquirySubtype = 'Enquiry ownership issue';
            String enquirySubtype1 = 'Credit Enquiry';
            
           	List<Case> getRecordList_enquiryern = Database.query('SELECT Account.Bureau_Member_Id__c,Account.Name,Sub_Type_Lookup__r.Name,Sub_Type_1_Lookup__r.Name,Case_Type_Lookup__r.Name, ' + String.join(lstFieldNames, ',') + ' FROM Case WHERE  Case_Type_Lookup__r.Name =:caseType  AND  Contact_Phone__c=:mobileNo AND (Sub_Type_Lookup__r.Name=:enquirySubtype OR Sub_Type_Lookup__r.Name=:enquirySubtype1)');
            
            System.debug('getRecordList_enquiryern size: ' + getRecordList_enquiryern.size());
            
            List<Map<String, Object>> enquiryernList = new List<Map<String, Object>>();
            Map<String, Boolean> enqErnMap = new Map<String, Boolean>(); // To ensure unique Enquiry_ERNs with status tracking
            
            // Process each Case record
            for (Case row : getRecordList_enquiryern) {
                String enquiryErn = null;
            
                // Determine which Enquiry_ERN to use
                if (row.Sub_Type_1_Lookup__r.Name == 'Credit Enquiry does not belong to me' 
                    || row.Sub_Type_1_Lookup__r.Name == 'Matching - Credit Enquiry does not belong to me') {
                    enquiryErn = row.Enquiry_ERN__c != null ? row.Enquiry_ERN__c : row.Enquiry_ERN_1__c;
                } else if (row.Sub_Type_1_Lookup__r.Name == 'Changes') {
                    enquiryErn = row.Enquiry_ERN_1__c;
                }
            
                // Skip if no valid Enquiry_ERN
                if (enquiryErn == null) continue;
            
                // Determine the flag value
                Boolean currentFlag = row.Status == 'Open' ? false : true;
            
                // Update map to keep track of the lowest flag value for each Enquiry_ERN
                if (!enqErnMap.containsKey(enquiryErn) || (currentFlag == false)) {
                    enqErnMap.put(enquiryErn, currentFlag);
                }
            }
            
            // Build the final list of unique Enquiry_ERNs
            for (String enqErn : enqErnMap.keySet()) {
                Map<String, Object> mpRow = new Map<String, Object>();
                mpRow.put('Enquiry_ERN', enqErn);
                mpRow.put('Flag', String.valueOf(enqErnMap.get(enqErn))); // Convert Boolean to String
                enquiryernList.add(mpRow);
            }
            
            // Debug the final list
            System.debug('Final EnquiryErnList: ' + enquiryernList);
            
            /*if(enquiryernList.size()==0){
                Map<String,Object> mpRow=new Map<String,Object>();
                    mpRow.put('Enquiry_ERN',true);
                    mpRow.put('Loan_Balance',true);
                 	enquiryernList.add(mpRow);
                }*/
            
            responseObj.put('Response_Status', 'Success');
            responseObj.put('Status', '200');
            responseObj.put('Dispute_Data_Point_Decision_Responses',DisputeStatusTrackingResponsesList);
            responseObj.put('EnquiryErnList',enquiryernList);
            response.responseBody = Blob.valueOf(JSON.serialize(responseObj));
            response.statusCode = 200;
            response.addHeader('Content-Type', 'application/json');
            ap.Response__c=String.valueOf(responseObj);
        }catch(Exception e){
            System.debug('e.getMessage() '+e.getMessage());
            responseObj.put('Response', e.getMessage());
            responseObj.put('Status', '400');
            response.responseBody = Blob.valueOf(JSON.serialize(responseObj));
            response.statusCode = 400;
            response.addHeader('Content-Type', 'application/json');
            ap.Exception_Description__c=e.getMessage();
            ap.Response__c=String.valueOf(responseObj);
        }
        insert ap;
    }
    
